# Simulator runtime state: logs, crashes, hardware and window preferences.
/FSOnline/Saved/
/FSOnline/Intermediate/
/FSOnline/DerivedDataCache/
/Engine/Intermediate/
/Engine/DerivedDataCache/

# Keep the packaged Engine manifest; ignore other Engine runtime output.
/Engine/Saved/*
!/Engine/Saved/Config/
/Engine/Saved/Config/*
!/Engine/Saved/Config/WindowsNoEditor/
/Engine/Saved/Config/WindowsNoEditor/*
!/Engine/Saved/Config/WindowsNoEditor/Manifest.ini

# Local Python runtimes, environments and generated bytecode.
/.tools/
/.venv/
/venv/
__pycache__/
*.py[cod]

# Python test, analysis and packaging output.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
/Python/build/
/Python/dist/

# Runtime logs and operating-system metadata.
*.log
Thumbs.db
Desktop.ini
.DS_Store
